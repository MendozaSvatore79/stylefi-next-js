{
  "name": "@stylefi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file .env.local",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build -w @stylefi/shared",
    "predev": "npm run build -w @stylefi/shared",
    "pretest": "npm run build -w @stylefi/shared",
    "db:migrar": "node --env-file-if-exists=.env.local dist/db/migrar.js",
    "predb:migrar": "nest build",
    "db:generar": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@stylefi/shared": "*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/node": "^20.19.43",
    "drizzle-kit": "0.31.11",
    "typescript": "^5",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}

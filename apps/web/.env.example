# Copia este archivo a .env.local y completa lo que necesites. .env.local no se sube al repo.

# Base de datos. En local: la de compose.yaml (npm run db:arriba).
# En producción: la de AWS RDS (exige SSL; nunca pongas aquí la de producción).
DATABASE_URL=postgres://stylefi:stylefi-local@127.0.0.1:54329/stylefi

# Clerk (inicio de sesión). Panel de Clerk → API keys. Nunca subas la llave secreta.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1


# Pagos: "mock" no cobra nada (para desarrollo). Stripe solo si vas a probar pagos reales.
PAYMENTS_MODE=mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Inicio de sesión con Google (opcional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo (opcional; sin esto no se envían correos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_ADMIN_EMAIL=

# Copia este archivo a .env.local y completa lo que necesites. .env.local no se sube al repo.
# Desde la fase 4 el front no lee la base ni tiene rutas de datos: todo va al backend (synova-backend).

# Backend (obligatoria: sin ella el front no compila ni arranca). En local: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk (inicio de sesión). Panel de Clerk → API keys. Nunca subas la llave secreta.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Stripe: la llave pública del formulario de tarjeta (sin ella, el formulario muestra un aviso).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
